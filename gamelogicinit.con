rem *** game settings
run FH2Settings/Game.txt
rem *** user settings
run FH2Settings/Graphics.txt
rem *** network settings
run FH2Settings/Network.txt

rem *** Put non level specific initializations here ***

rem *** Load multiplayer free camera here
run Common/FreeCamera/Object.con

gameLogic.setDefaultNumberOfTickets 1 250
gameLogic.setDefaultNumberOfTickets 2 250

gameLogic.enableVoHelp 1
gameLogic.supplyDropHeight 150
gameLogic.supplyDropNumSecsToLive 100
gamelogic.vehicleDropHeight 150

include fh2settings/gameplay.con

rem testing mode
const c_testing = 0

if c_testing == 1
sv.allowfreecam 1
renderer.drawNametags 0
gameLogic.enableVoHelp 0
sv.spawntime 1
sv.mandowntime 2.5
sv.numPlayersNeededToStart 1
sv.radioBlockedDurationTime 0
sv.radioMaxSpamFlagCount 10000
sv.radioSpamInterval 1
endIf

rem Workaround for shipload of BF2 graphics bugs.
rem It breaks some stuff, but fixes even more!
renderer.allowA2M 0
rem fix BF2 1p weapon z-fighting. Primarily on nvidia cards.
renderer.tweaknearplane1p 0.04

